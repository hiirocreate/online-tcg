{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@tcg/shared": ["../../shared/types/index.ts"],
      "@tcg/shared/constants": ["../../shared/constants/index.ts"],
      "@tcg/shared/validation": ["../../shared/validation/index.ts"]
    }
  },
  "include": ["src"]
}
