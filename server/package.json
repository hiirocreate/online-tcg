{
  "name": "@tcg/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "prisma:generate": "prisma generate --schema database/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema database/schema.prisma",
    "db:seed": "tsx database/seed.ts"
  },
  "prisma": {
    "seed": "tsx database/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@tcg/shared": "*",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "jose": "^5.9.6",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/pg": "^8.16.0",
    "prisma": "^7.10.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
