{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@tcg/shared": ["../shared/types/index.ts"],
      "@tcg/shared/constants": ["../shared/constants/index.ts"],
      "@tcg/shared/validation": ["../shared/validation/index.ts"]
    }
  },
  "include": ["**/*.ts", "../shared/**/*.ts"],
  "exclude": ["node_modules", "dist", "../shared/**/*.test.ts"]
}
