{
  "name": "online-tcg-project",
  "private": true,
  "version": "0.1.0",
  "description": "オンライン対戦カードゲーム（Web / Android / Server 共通ルートpackage.json）",
  "workspaces": [
    "shared",
    "server",
    "client/web",
    "client/android"
